{
	"layer": "bot",
  "spacing": 0,
  "height": 0,
  "position": "top",
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-center": [
		"clock"
  ],
	"modules-right": [
		"network",
		"pulseaudio",
		"battery",
		"custom/power"
	],

	"custom/power": {
		"format": "⏻",
		"on-click": "wlogout",
		"tooltip": false
	},

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": false,
		"tooltip": false
	},
	"tray": {
		"spacing": 10,
		"tooltip": false
	},
	"clock": {
		"format": "{:%d %H:%M %m}",
    "tooltip": false
	},
	"network": {
    "format-wifi": "  {bandwidthDownBits}",
    "format-ethernet": "  {bandwidthDownBits}",
    "format-disconnected": "󰤮  No Network",
    "interval": 5,
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-icons": [
      "",
      "",
      " "
    ],
    "nospacing": 1,
    "format-muted": " ",
    "on-click": "kitty wiremix",
    "tooltip": false
  },
	"battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄{capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "format-icons": [
      "󱊡",
      "󱊢",
      "󱊣"
    ]
  }
}
